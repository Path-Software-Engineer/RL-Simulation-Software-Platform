{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paths.dev/schemas/rl/message-envelope-v1.schema.json",
  "title": "RL message envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "message_type", "schema_version", "occurred_at", "correlation_id", "causation_id", "run_id", "attempt", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "message_type": {"type": "string", "pattern": "^rl\\.(run|rollout)\\.[a-z-]+\\.v1$"},
    "schema_version": {"const": "1.0"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 5},
    "payload": {"type": "object", "maxProperties": 20}
  }
}
