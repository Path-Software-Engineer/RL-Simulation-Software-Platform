POSTGRES_DB=rl_control
POSTGRES_USER=rl_control
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://rl_control:local-development-only@timescaledb:5432/rl_control?sslmode=disable
REDIS_URL=redis://redis:6379/0
OPERATOR_TOKEN=local-operator-token-change-me
COMMAND_STREAM=rl.commands.v1
EVENT_STREAM=rl.events.v1
DEAD_LETTER_STREAM=rl.dead-letter.v1
RUNNER_CONSUMER_GROUP=rl-runner-v1
PROJECTOR_CONSUMER_GROUP=control-api-projector-v1
API_PORT=8080
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8080
NUXT_PUBLIC_WS_BASE=ws://127.0.0.1:8080
WEB_PORT=3000
RUNNER_STEP_DELAY_MS=120
NEON_DATABASE_URL=
NEON_DATABASE_URL_DIRECT=
